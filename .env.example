TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_BOT_USERNAME=pakkkobot
OPENAI_API_KEY=sk-replace-me

# GPT-5.4 mini is the default balanced model. Override without code changes.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=90
OPENAI_REQUEST_RETRIES=3
MAX_ANSWER_SECONDS=45

DATABASE_PATH=data/pakko.sqlite3
LOG_LEVEL=INFO
ENABLE_WEB_SEARCH=true
WEB_SEARCH_CONTEXT_SIZE=medium
CONTEXT_TTL_SECONDS=600
MAX_RECENT_MESSAGES=12
SUMMARIZE_AFTER_MESSAGES=24
MAX_RESPONSE_CHARS=3500
MAX_INPUT_FILE_BYTES=20000000

# Used only for approximate cost logging. Keep in sync with current OpenAI pricing.
OPENAI_INPUT_PRICE_USD_PER_MILLION=0.75
OPENAI_OUTPUT_PRICE_USD_PER_MILLION=4.50
